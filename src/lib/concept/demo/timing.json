  "phrases": [
    {
      "phrase": 1,
      "start": 0.197,
      "end": 3.441,
      "text": "The Talmud permits pedophilia. Let's talk about this lie."
    },
    {
      "phrase": 2,
      "start": 4.208,
      "end": 7.131,
      "text": "First, it doesn't. This claim is a fabrication."
    },
    {
      "phrase": 3,
      "start": 7.841,
      "end": 8.774,
      "text": "And it's a dangerous one."
    },
    {
      "phrase": 4,
      "start": 9.822,
      "end": 11.691,
      "text": "It is one of the oldest anti-Semitic tropes."
    },
    {
      "phrase": 5,
      "start": 12.954,
      "end": 13.957,
      "text": "Here's how the lie works."
    },
    {
      "phrase": 6,
      "start": 14.837,
      "end": 18.184,
      "text": "Anti-Semites take a handful of lines from a 1,500-year-old legal text,"
    },
    {
      "phrase": 7,
      "start": 18.682,
      "end": 20.814,
      "text": "strip them of context, mistranslate them,"
    },
    {
      "phrase": 8,
      "start": 21.28,
      "end": 23.93,
      "text": "and twist their meaning to construct something they were never saying."
    },
    {
      "phrase": 9,
      "start": 25.257,
      "end": 27.42,
      "text": "This isn't new. It's the same blood libel"
    },
    {
      "phrase": 10,
      "start": 27.42,
      "end": 30.526,
      "text": "that's been used to justify pogroms, and massacres for centuries."
    },
    {
      "phrase": 11,
      "start": 31.399,
      "end": 35.574,
      "text": "Accused Jews of harming children, then use that accusation as license for violence."
    },
    {
      "phrase": 12,
      "start": 36.88,
      "end": 39.239,
      "text": "So when you see this claim, know exactly what it is."
    },
    {
      "phrase": 13,
      "start": 40.065,
      "end": 43.61,
      "text": "A lie with a long, ugly history being repackaged for a new audience."
    },
    {
      "phrase": 14,
      "start": 44.686,
      "end": 50.438,
      "text": "Don't platform it. Don't debate it like it's a legitimate question. Expose it."
    }
  ],
  "estimated": false
