 "phrases": [
  {
   "phrase": 1,
   "start": 0.05,
   "end": 1.418,
   "text": "Jews control the media?"
  },
  {
   "phrase": 2,
   "start": 2.142,
   "end": 2.704,
   "text": "Really?"
  },
  {
   "phrase": 3,
   "start": 3.244,
   "end": 6.572,
   "text": "Then somebody needs to explain why the Jews are so terrible at PR."
  },
  {
   "phrase": 4,
   "start": 7.082,
   "end": 11.798,
   "text": "If Jews control the headlines, why is so much coverage of Israel relentlessly negative?"
  },
  {
   "phrase": 5,
   "start": 12.284,
   "end": 17.974,
   "text": "If Jews control social media, why do antisemitic conspiracy theories go viral every single day?"
  },
  {
   "phrase": 6,
   "start": 18.426,
   "end": 23.16,
   "text": "And if Jews control the narrative, how did \"Jews control the media\" become a viral narrative?"
  },
  {
   "phrase": 7,
   "start": 24.156,
   "end": 25.376,
   "text": "Make it make sense."
  },
  {
   "phrase": 8,
   "start": 26.078,
   "end": 30.584,
   "text": "Apparently, Jews are responsible for everything, including the propaganda against themselves."
  },
  {
   "phrase": 9,
   "start": 31.506,
   "end": 34.344,
   "text": "That's not a conspiracy. That's a plot hole."
  },
  {
   "phrase": 10,
   "start": 35.108,
   "end": 38.67,
   "text": "Maybe stop blaming the Jews and start questioning what you're being fed."
  }
 ],
