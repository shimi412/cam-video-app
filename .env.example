# Local database (embedded postgres started with `pnpm db:start`)
DATABASE_URL=postgres://cam:cam@localhost:5433/cam_video_app

# Framing brain:
#  mock = deterministic heuristic (zero cost, offline)
#  cli  = local Claude Code CLI, runs on the dev machine's Claude subscription (dev only)
#  api  = OpenRouter (DeepSeek for chat, Claude for reasoning and production)
BRAIN_MODE=mock

# Media generation:
#  mock   = placeholder media, simulated costs (zero API spend)
#  dryrun = placeholders + production sheet (exact fal.ai requests)
#  mock and dryrun also disable ALL brain calls and never debit client credits,
#  regardless of BRAIN_MODE. Use `pnpm dev:preview` for a safe local session.
#  fal    = real fal.ai calls on the Bina account (needs FAL_KEY)
PROVIDER_MODE=dryrun

# Authentication: local bypass only in development + offline mode + loopback host.
# Production always requires authentication, even if CAM_AUTH_MODE=local.
CAM_AUTH_MODE=required
# Set the canonical HTTPS URL and generate a random secret before deployment.
APP_URL=http://127.0.0.1:3106
AUTH_URL=http://127.0.0.1:3106
AUTH_SECRET=
# Set only behind the configured trusted reverse proxy.
AUTH_TRUST_HOST=true

# Wan 2.5 resolution for the standard tier: 480p ($0.05/s), 720p ($0.10/s), 1080p ($0.15/s)
FAL_WAN_RESOLUTION=720p

# Which engine produces the clips in real mode: fal (default) or runway.
# Runway is video-only: images, voice, cut-outs and timestamps stay on fal either way.
# Benchmark lane — compare the cost first with `pnpm compare:video`.
VIDEO_PROVIDER=fal

# Runway models per tier (only for VIDEO_PROVIDER=runway). Credits are $0.01 each.
#  standard: wan3-480p | wan3-720p | wan3-1080p | gen4.5
#  premium:  seedance2_5-480p | seedance2_5-720p | seedance2_5-1080p | veo3.1-silent | veo3.1-audio
RUNWAY_VIDEO_STANDARD=wan3-720p
RUNWAY_VIDEO_PREMIUM=seedance2_5-720p

# OpenRouter — or save the key through Admin > AI connections
OPENROUTER_API_KEY=
# Explicit connected workspace; production still requires a confirmed quote.
CAM_LIVE_ENABLED=0
# Optional private credential file outside the repository
# CAM_CREDENTIALS_FILE=/secure/location/cam-credentials.json
# Existing Higgsfield MCP OAuth grant, refreshed in place for Bram
# CAM_HIGGSFIELD_AUTH_FILE=/secure/location/higgsfield-tokens.json

# fal.ai (Bina account) — only for PROVIDER_MODE=fal
FAL_KEY=

# Runway (Bina account) — only for VIDEO_PROVIDER=runway
RUNWAYML_API_SECRET=

# Optional: absolute path to the claude binary if not on PATH
# CLAUDE_CLI_PATH=/Users/you/.local/bin/claude

# Bina Stripe checkout. Keep blank until payment activation. No test payment grants real credits.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Canonical public origin for checkout return URLs (HTTPS when deployed)
CAM_PUBLIC_URL=

# Workspace media reservation ceilings. Defaults preserved; increasing a ceiling
# does not authorize a generation: each complete quote still needs approval.
CAM_WORKSPACE_USD_CEILING=100
CAM_WORKSPACE_HIGGSFIELD_CREDIT_CEILING=100

# Code-only motion worker. Python/Chromium are local; unsupported platforms fail closed.
# CAM_MOTION_PYTHON=/absolute/path/to/python-venv/bin/python
# CAM_MOTION_CHROME=/absolute/path/to/chrome-headless-shell
# CAM_MOTION_FFMPEG=/absolute/path/to/ffmpeg
# CAM_MOTION_FFPROBE=/absolute/path/to/ffprobe
# CAM_MOTION_WHISPER_MODEL=/absolute/path/to/ggml-medium.bin
# Defaults to the configured deep writer; only Claude identifiers are accepted.
# CAM_MOTION_MODEL=anthropic/claude-fable-5.1   # Shimi 2026-10-21; default anthropic/claude-sonnet-5
# Motion narration voice (Higgsfield preset). Bram by default since 2026-10-21; Dylan was b847bc29-f184-583a-8ad9-d1f1e16d1a60.
# CAM_MOTION_VOICE_ID=549ff70a-3ee7-4f04-a4d9-89a24fab7709
# Reasoning effort of the Claude tool loop (writer, supervisor, reviewer): low, medium or high.
CAM_MOTION_EFFORT=medium
CAM_MOTION_WRITING_CAP_USD=2   # 8 on Fable 5.1
# CAM_MOTION_REVIEW_CAP_USD=0.35   # 1.5 on Fable 5.1
# CAM_MOTION_FEEDBACK_CAP_USD=0.20   # 0.6 on Fable 5.1
# CAM_MOTION_WRITER=agent   # default: contract 6, agent with tools; 'legacy' keeps contract 5
# CAM_MOTION_AGENT_STEPS=40
# CAM_MOTION_AGENT_CONTINUATIONS=3
# CAM_MOTION_STEP_OUTPUT_TOKENS=12000
# CAM_MOTION_REASONING_TOKENS is ignored by Fable and refused with effort by OpenRouter: use CAM_MOTION_EFFORT (low recommended for Motion)
# CAM_MOTION_PRICE_CEILING_USD=30   # cumulative client price per film (was 20 before 2026-10-21)
# Per code-repair turn allowance (writer + $0.35 visual review). Default 0.75; raise only with an explicit spending authorization.
# CAM_MOTION_REPAIR_CAP_USD=0.75
# Explicit prompt caching for the Claude tool loop (OpenRouter cache_control, Anthropic 5-minute TTL).
# Verified live on 2026-10-21: second request 8x cheaper, same provider. Enabled on Shimi's machine.
CAM_AGENT_PROMPT_CACHE=1
CAM_MOTION_VOICE_CAP_CREDITS=3
# Attack (comics) director/inspection model override, as CAM_CLAY_MODEL for Clay (default: admin ai_deep_model, else anthropic/claude-sonnet-5)
CAM_COMICS_MODEL=
